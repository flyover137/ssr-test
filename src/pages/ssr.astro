---
export const prerender = false;

const timestamp = new Date().toLocaleTimeString();
const random = Math.floor(Math.random() * 1000);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SSR Demo</title>
    <style>
      :root { color-scheme: light dark; }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        max-width: 540px;
        margin: 3rem auto;
        padding: 0 1rem;
        line-height: 1.6;
      }
      nav { margin-bottom: 2rem; display: flex; gap: 1rem; }
      .box {
        border: 2px solid #3b82f6;
        border-radius: 8px;
        padding: 1.25rem;
        margin: 1.5rem 0;
      }
      .badge {
        display: inline-block;
        background: #3b82f6;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/ssg">SSG</a>
      <strong>SSR</strong>
    </nav>

    <span class="badge">Server-Side Rendering</span>
    <h1>SSR Page</h1>
    <p>Rendered on-demand by Cloudflare Worker on every request.</p>

    <div class="box">
      <p><strong>Request Time:</strong> {timestamp}</p>
      <p><strong>Request Random #:</strong> {random}</p>
    </div>

    <p>🔄 <em>Reload the page — the time and number will <strong>change every time</strong>.</em></p>
  </body>
</html>
