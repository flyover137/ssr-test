---
export const prerender = true;

const timestamp = new Date().toLocaleTimeString();
const random = Math.floor(Math.random() * 1000);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SSG Demo</title>
    <style>
      :root { color-scheme: light dark; }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        max-width: 540px;
        margin: 3rem auto;
        padding: 0 1rem;
        line-height: 1.6;
      }
      nav { margin-bottom: 2rem; display: flex; gap: 1rem; }
      .box {
        border: 2px solid #22c55e;
        border-radius: 8px;
        padding: 1.25rem;
        margin: 1.5rem 0;
      }
      .badge {
        display: inline-block;
        background: #22c55e;
        color: #000;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <strong>SSG</strong>
      <a href="/ssr">SSR</a>
    </nav>

    <span class="badge">Static Site Generation</span>
    <h1>SSG Page</h1>
    <p>Pre-rendered at build time (<code>export const prerender = true</code>).</p>

    <div class="box">
      <p><strong>Build Time:</strong> {timestamp}</p>
      <p><strong>Build Random #:</strong> {random}</p>
    </div>

    <p>🔄 <em>Reload the page — the time and number will <strong>never change</strong>.</em></p>
  </body>
</html>
